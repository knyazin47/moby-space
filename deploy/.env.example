# Copy to deploy/.env and replace this example with a local random value.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MOBY_BOOTSTRAP_SECRET=
MOBY_REST_PORT=18080
MOBY_GRPC_PORT=19090
# Optional YYYY-MM-DD override; empty uses the backend default.
MOBY_BUSINESS_DATE=
MOBY_IMAGE_TAG=dev
